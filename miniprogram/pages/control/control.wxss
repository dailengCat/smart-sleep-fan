.head { margin-bottom: 28rpx; }

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 500;
  letter-spacing: -1rpx;
  color: #f4f0e6;
}

.lead {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #c9c2b4;
}

.lead.quiet { margin-bottom: 36rpx; }

.now { margin: 12rpx 0 48rpx; }

.now-k,
.label {
  display: block;
  font-size: 22rpx;
  color: #8d867a;
}

.now-v {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #f4f0e6;
}

.now-s {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #c9c2b4;
}

.block { margin-bottom: 48rpx; }

.track {
  position: relative;
  display: flex;
  flex-direction: row;
  height: 104rpx;
  margin-top: 16rpx;
  border-radius: 32rpx;
  background: #1c1b18;
  overflow: hidden;
}

.thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 16.6667%;
  height: 100%;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
  transition: transform 0.48s cubic-bezier(0.22, 1.35, 0.36, 1);
}

.thumb-fill {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  background: #e6d3b4;
}

.thumb.half { width: 50%; }

.thumb.right {
  transform: translateX(100%);
}

.key {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 32rpx;
  color: #8d867a;
  transition: color 0.28s ease, transform 0.42s cubic-bezier(0.22, 1.25, 0.36, 1);
}

.key.on {
  color: #1a1612;
  font-weight: 600;
}

.key.press { transform: scale(0.92); }

.hint,
.log-time,
.log-note {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8d867a;
}

.pair {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.text-btn {
  flex: 1;
  height: 96rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: #1c1b18;
  color: #f4f0e6;
  font-size: 30rpx;
  line-height: 96rpx;
  text-align: center;
  transition: transform 0.42s cubic-bezier(0.22, 1.25, 0.36, 1);
}

.text-btn:last-child { margin-right: 0; }
.text-btn.press { transform: scale(0.96); }

.payload,
.log-body {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #e6d3b4;
  word-break: break-all;
}

.log {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(244, 240, 230, 0.08);
}
